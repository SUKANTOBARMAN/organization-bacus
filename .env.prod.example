# সার্ভারে এই ফাইলটি .env.prod নামে রাখুন (গিটে কমিট করবেন না)
# docker compose এই একই ফাইল --env-file দিয়ে পড়ে: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
IMAGE_PREFIX=ghcr.io/YOUR_GITHUB_USER/YOUR_REPO
DOMAIN=example.org
API_DOMAIN=api.example.org

DB_DATABASE=organization
DB_USERNAME=organization
DB_PASSWORD=CHANGE_ME_STRONG
DB_ROOT_PASSWORD=CHANGE_ME_STRONGER
DB_HOST=db
DB_CONNECTION=mysql
DB_PORT=3306

APP_NAME="Organization API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.org
APP_TIMEZONE=Asia/Dhaka
APP_KEY=            # লোকালে `php artisan key:generate --show` চালিয়ে বসান
FRONTEND_URL=https://example.org
LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE_ME_NOW
